<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="320.0" prefWidth="380.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cesur.dam.controllers.LoginViewController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Gestión de Inventario">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Módulo de Control de Acceso" textFill="#666666" />
        <Button mnemonicParsing="false" onAction="#onLoginClick" prefHeight="38.0" prefWidth="180.0" text="Acceder al Panel" />
    </children>
</VBox>